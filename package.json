{
  "name": "hermes2dsh",
  "version": "0.1.0",
  "description": "Migrate Hermes Agent (~/.hermes) user data into DeepSeek Harness / DSH (~/.dsh)",
  "type": "module",
  "bin": {
    "hermes2dsh": "./bin/hermes2dsh.js"
  },
  "main": "./lib/dsh-plugin.js",
  "files": [
    "bin",
    "src",
    "lib",
    "mappings",
    "skills",
    "com.deepseek.harness",
    "plugin.json",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node ./bin/hermes2dsh.js",
    "preview": "node ./bin/hermes2dsh.js preview",
    "test:fixture": "node ./bin/hermes2dsh.js preview --hermes-home ./fixtures/sample-hermes --dsh-home ./fixtures/sample-dsh --workspace-target ./fixtures/sample-dsh/workspace",
    "ds:codegen": "node ./dev/scripts/ds-codegen.js",
    "ds:codegen:dry": "node ./dev/scripts/ds-codegen.js --dry-write",
    "test": "node test/skill-flatten.mjs && node test/memory-merge.mjs && node test/cron-full.mjs && node test/plugin-pack.mjs",
    "test:unit": "node test/skill-flatten.mjs && node test/memory-merge.mjs && node test/cron-full.mjs && node test/plugin-pack.mjs",
    "test:all": "npm run test && npm run test:fixture",
    "role:review": "node ./dev/scripts/run-role.mjs --role reviewer --local",
    "test:plugin": "node test/plugin-pack.mjs"
  },
  "keywords": [
    "hermes",
    "dsh",
    "deepseek",
    "migration",
    "cli",
    "deepseek-harness",
    "dsh-plugin",
    "agent-plugins",
    "skills",
    "import"
  ],
  "author": "james chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/hermes2dsh"
  },
  "exports": {
    ".": "./lib/dsh-plugin.js",
    "./cli": "./src/cli.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
